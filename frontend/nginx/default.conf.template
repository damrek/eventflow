# Compose front door: one origin for the SPA and the three service prefixes.
#
# The prefix rewrite mirrors frontend/vite.config.ts: /api/catalog/events -> /api/events, so the
# browser code never learns where a service lives. The upstreams are environment variables
# rendered by the official nginx entrypoint (envsubst only replaces variables that exist in the
# environment, so $uri, $host and $catalog are left alone).
#
# The upstream is passed through a variable and resolved per request by Docker's embedded DNS
# (127.0.0.11), so recreating one service — `docker compose up -d --force-recreate catalog` — is
# picked up within `valid=` instead of leaving the prefix at 502 until nginx restarts.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    resolver 127.0.0.11 ipv6=off valid=10s;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Checkout waits for the simulated provider, so the timeouts are generous but finite.
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /api/catalog/ {
        set $catalog ${CATALOG_UPSTREAM};
        rewrite ^/api/catalog/(.*)$ /api/$1 break;
        proxy_pass http://$catalog;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/booking/ {
        set $booking ${BOOKING_UPSTREAM};
        rewrite ^/api/booking/(.*)$ /api/$1 break;
        proxy_pass http://$booking;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/notification/ {
        set $notification ${NOTIFICATION_UPSTREAM};
        rewrite ^/api/notification/(.*)$ /api/$1 break;
        proxy_pass http://$notification;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Client-side routing: every unknown path is the SPA shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
