# PostgreSQL (Docker Compose, profile "core")
POSTGRES_PORT=5432
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=eventflow
CATALOG_DB=catalog_db
BOOKING_DB=booking_db
NOTIFICATION_DB=notification_db

# RabbitMQ (Docker Compose, profile "core")
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=eventflow
RABBITMQ_PASSWORD=eventflow

# Catalog service
CATALOG_PORT=8081
CATALOG_DB_URL=jdbc:postgresql://localhost:5432/catalog_db
CATALOG_DB_USER=eventflow
CATALOG_DB_PASSWORD=eventflow

# Booking service
BOOKING_PORT=8082
BOOKING_DB_URL=jdbc:postgresql://localhost:5432/booking_db
BOOKING_DB_USER=eventflow
BOOKING_DB_PASSWORD=eventflow
# Hold duration and expiry worker cadence (ISO-8601 durations).
BOOKING_RESERVATION_TTL=PT10M
BOOKING_EXPIRY_INTERVAL=PT5S
BOOKING_EXPIRY_BATCH_SIZE=50

# Notification service
NOTIFICATION_PORT=8083
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db
NOTIFICATION_DB_USER=eventflow
NOTIFICATION_DB_PASSWORD=eventflow

# Messaging shared by the services that publish or consume events.
RABBITMQ_HOST=localhost
EVENTFLOW_EXCHANGE=eventflow.events
EVENTFLOW_DLX=eventflow.events.dlx
# One retry queue per delay, in order; the last failure goes to the DLQ.
EVENTFLOW_RETRY_DELAYS=5s,15s,45s
EVENTFLOW_OUTBOX_INTERVAL=PT1S
EVENTFLOW_OUTBOX_BATCH_SIZE=50
