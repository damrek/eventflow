# PostgreSQL (Docker Compose, profile "core")
POSTGRES_PORT=5432
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=eventflow
CATALOG_DB=catalog_db
BOOKING_DB=booking_db
NOTIFICATION_DB=notification_db
PAYMENT_DB=payment_db

# RabbitMQ (Docker Compose, profile "core")
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=eventflow
RABBITMQ_PASSWORD=eventflow

# Redis (Docker Compose, profile "core"); ephemeral, never the stock authority.
REDIS_HOST=localhost
REDIS_PORT=6379

# Catalog service
CATALOG_PORT=8081
CATALOG_DB_URL=jdbc:postgresql://localhost:5432/catalog_db
CATALOG_DB_USER=eventflow
CATALOG_DB_PASSWORD=eventflow

# Booking service
BOOKING_PORT=8082
BOOKING_DB_URL=jdbc:postgresql://localhost:5432/booking_db
BOOKING_DB_USER=eventflow
BOOKING_DB_PASSWORD=eventflow
# Hold duration and expiry worker cadence (ISO-8601 durations).
BOOKING_RESERVATION_TTL=PT10M
BOOKING_EXPIRY_INTERVAL=PT5S
BOOKING_EXPIRY_BATCH_SIZE=50
# Redis waiting room: dispatcher cadence, batch per event and admission token lifetime.
BOOKING_WAITING_ROOM_DISPATCH_INTERVAL=PT2S
BOOKING_WAITING_ROOM_BATCH_SIZE=25
BOOKING_WAITING_ROOM_ADMISSION_TTL=PT2M
# Fixed-window rate limit per user and endpoint (join / reservation creation).
BOOKING_RATE_LIMIT_WINDOW=PT1M
BOOKING_RATE_LIMIT_JOIN_MAX=60
BOOKING_RATE_LIMIT_RESERVATION_MAX=300

# Notification service
NOTIFICATION_PORT=8083
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db
NOTIFICATION_DB_USER=eventflow
NOTIFICATION_DB_PASSWORD=eventflow

# Payment service and its HTTP provider simulator
PAYMENT_PORT=8084
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/payment_db
PAYMENT_DB_USER=eventflow
PAYMENT_DB_PASSWORD=eventflow
PAYMENT_SIMULATOR_PORT=8085
PAYMENT_PROVIDER_URL=http://localhost:8085/simulator/authorizations
# The ".99" scenario waits this long, longer than the client read timeout below.
PAYMENT_SIMULATOR_TIMEOUT_DELAY=PT5S
PAYMENT_PROVIDER_CONNECT_TIMEOUT=2s
PAYMENT_PROVIDER_READ_TIMEOUT=2s
# Circuit breaker: window, minimum calls, failure rate (%), open wait, half-open calls.
PAYMENT_CB_WINDOW=10
PAYMENT_CB_MIN_CALLS=5
PAYMENT_CB_FAILURE_RATE=50
PAYMENT_CB_OPEN_WAIT=PT10S
PAYMENT_CB_HALF_OPEN_CALLS=3

# Messaging shared by the services that publish or consume events.
RABBITMQ_HOST=localhost
EVENTFLOW_EXCHANGE=eventflow.events
EVENTFLOW_DLX=eventflow.events.dlx
# One retry queue per delay, in order; the last failure goes to the DLQ.
EVENTFLOW_RETRY_DELAYS=5s,15s,45s
EVENTFLOW_OUTBOX_INTERVAL=PT1S
EVENTFLOW_OUTBOX_BATCH_SIZE=50

# Container stack (Compose profiles "core" + "app"; see scripts/stack-up.sh).
# APP_PORT is the only published application port: the SPA and /api/* share it.
APP_PORT=8080
# Tag of the locally built images eventflow/<service>:<tag>.
EVENTFLOW_TAG=local
