# PostgreSQL (Docker Compose, profile "core")
POSTGRES_PORT=5432
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=eventflow
CATALOG_DB=catalog_db
BOOKING_DB=booking_db

# Catalog service
CATALOG_PORT=8081
CATALOG_DB_URL=jdbc:postgresql://localhost:5432/catalog_db
CATALOG_DB_USER=eventflow
CATALOG_DB_PASSWORD=eventflow

# Booking service
BOOKING_PORT=8082
BOOKING_DB_URL=jdbc:postgresql://localhost:5432/booking_db
BOOKING_DB_USER=eventflow
BOOKING_DB_PASSWORD=eventflow
# Hold duration and expiry worker cadence (ISO-8601 durations).
BOOKING_RESERVATION_TTL=PT10M
BOOKING_EXPIRY_INTERVAL=PT5S
BOOKING_EXPIRY_BATCH_SIZE=50
